		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
    СпрТовары.Ссылка КАК Товар,
    ЕСТЬNULL(Остатки.КоличествоОстаток, 0) КАК ОстатокНаДату,
    ЕСТЬNULL(Обороты.КоличествоОборот, 0)   КАК КоличествоОборот,
    ЕСТЬNULL(Обороты.СуммаОборот, 0)        КАК СуммаОборот
ИЗ
    Справочник.Товары КАК СпрТовары
    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОстаткиТоваров.Остатки(&amp;ДатаОстатков, ) КАК Остатки
        ПО Остатки.Товары = СпрТовары.Ссылка
    ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ОборотыТоваров.Обороты(&amp;НачалоПериода, &amp;КонецПериода, , ) КАК Обороты
        ПО Обороты.Товар = СпрТовары.Ссылка
ГДЕ
    СпрТовары.ЭтоГруппа = ЛОЖЬ</query>
