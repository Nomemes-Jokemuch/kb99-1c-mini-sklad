
Процедура ОбработкаПроведения(Отказ, Режим)
    
    Движения.ОстаткиТоваров.Записывать = Истина;
    Движения.ОборотыТоваров.Записывать = Истина;
    Движения.ПартииТоваров.Записывать = Истина;
    
    Движения.ПартииТоваров.Записать();
    
    // FIFO
    ЗапросПартии = Новый Запрос;
    ЗапросПартии.Текст =
    "ВЫБРАТЬ
    |    Остатки.Партия КАК Партия,
    |    Остатки.КоличествоОстаток КАК Остаток
    |ИЗ
    |    РегистрНакопления.ПартииТоваров.Остатки(
    |        &Дата,
    |        Товар = &Товар) КАК Остатки
    |ГДЕ
    |    Остатки.КоличествоОстаток > 0
    |УПОРЯДОЧИТЬ ПО
    |    Остатки.Партия.Дата";
    
    Для Каждого ТекСтрокаТовары Из Товары Цикл
        
        ЗапросПартии.УстановитьПараметр("Дата", Дата);
        ЗапросПартии.УстановитьПараметр("Товар", ТекСтрокаТовары.Товар);
        ВыборкаПартий = ЗапросПартии.Выполнить().Выбрать();
        
        ОсталосьСписать = ТекСтрокаТовары.Количество;
        
        Пока ОсталосьСписать > 0 И ВыборкаПартий.Следующий() Цикл
            
            КоличествоСписать = Мин(ВыборкаПартий.Остаток, ОсталосьСписать);
            
            ДвижениеПартии = Движения.ПартииТоваров.Добавить();
            ДвижениеПартии.ВидДвижения = ВидДвиженияНакопления.Расход;
            ДвижениеПартии.Период      = Дата;
            ДвижениеПартии.Товар       = ТекСтрокаТовары.Товар;
            ДвижениеПартии.Партия      = ВыборкаПартий.Партия;
            ДвижениеПартии.Количество  = КоличествоСписать;
            
            // Списываем остатки с указанием конкретной партии.
            ДвижениеОстатков = Движения.ОстаткиТоваров.Добавить();
            ДвижениеОстатков.ВидДвижения = ВидДвиженияНакопления.Расход;
            ДвижениеОстатков.Период      = Дата;
            ДвижениеОстатков.Товары      = ТекСтрокаТовары.Товар;
            ДвижениеОстатков.Партия      = ВыборкаПартий.Партия;
            ДвижениеОстатков.Количество  = КоличествоСписать;
            
            ОсталосьСписать = ОсталосьСписать - КоличествоСписать;
            
        КонецЦикла;
        
        Если ОсталосьСписать > 0 Тогда
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Не хватает товара """ + Строка(ТекСтрокаТовары.Товар)
                + """ в количестве " + Строка(ОсталосьСписать) + " (нет партий на складе)";
            Сообщение.Сообщить();
            
            Отказ = Истина;
            Возврат;
        КонецЕсли;
        
        Движения.ПартииТоваров.Записать();
                
        // Оборотный регистр
        Движение = Движения.ОборотыТоваров.Добавить();
        Движение.Период      = Дата;
        Движение.Контрагент  = Контрагент;
        Движение.Товар       = ТекСтрокаТовары.Товар;
        Движение.Количество  = ТекСтрокаТовары.Количество;
        Движение.Сумма       = ТекСтрокаТовары.Сумма;
        
    КонецЦикла;
    
    Движения.Записать();
    
    // Контроль отрицательных остатков 
    Если Режим = РежимПроведенияДокумента.Оперативный Тогда
        
        Запрос = Новый Запрос;
        Запрос.Текст =
        "ВЫБРАТЬ
        |    ОстаткиТоваровОстатки.Товары КАК Товары,
        |    ОстаткиТоваровОстатки.КоличествоОстаток КАК КоличествоОстаток
        |ИЗ
        |    РегистрНакопления.ОстаткиТоваров.Остатки(
        |        ,
        |        Товары В (
        |            ВЫБРАТЬ РАЗЛИЧНЫЕ
        |                ДокТовары.Товар
        |            ИЗ
        |                Документ.Реализация.Товары КАК ДокТовары
        |            ГДЕ
        |                ДокТовары.Ссылка = &Ссылка
        |        )
        |    ) КАК ОстаткиТоваровОстатки
        |ГДЕ
        |    ОстаткиТоваровОстатки.КоличествоОстаток < 0";
        
        Запрос.УстановитьПараметр("Ссылка", Ссылка);
        
        Выборка = Запрос.Выполнить().Выбрать();
        
        Пока Выборка.Следующий() Цикл
            Сообщение = Новый СообщениеПользователю;
            Сообщение.Текст = "Не хватает " + Строка(-Выборка.КоличествоОстаток)
                + " единиц товара """ + Строка(Выборка.Товары) + """";
            Сообщение.Сообщить();
            
            Отказ = Истина;
        КонецЦикла;
        
    КонецЕсли;
    
КонецПроцедуры